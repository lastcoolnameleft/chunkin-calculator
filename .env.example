PORT=3000
DB_PATH=./data/tracker.db

# Production Compose configuration
COMPOSE_PROJECT_NAME=chunkin-calculator
IMAGE=ghcr.io/lastcoolnameleft/chunkin-calculator:latest
TRAEFIK_HOST=tracker.dfwtrebuchet.com
TRAEFIK_CERT_RESOLVER=myresolver
DATA_DIR=./data
# Traefik runs in host network mode on the production VM.
# Set to the app network gateway IP if that is Traefik's source address.
# Find with: docker network inspect chunkin-calculator_default --format '{{json .IPAM.Config}}'
# Comma-separated IP addresses/CIDRs; never use true or trust every address.
TRUST_PROXY=
