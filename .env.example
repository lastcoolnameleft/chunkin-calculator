PORT=3000
DB_PATH=./data/tracker.db

# Production Compose configuration
COMPOSE_PROJECT_NAME=chunkin-calculator
IMAGE=ghcr.io/lastcoolnameleft/chunkin-calculator:latest
TRAEFIK_HOST=distance.dfwtrebuchet.com
TRAEFIK_NETWORK=traefik
TRAEFIK_CERT_RESOLVER=myresolver
DATA_DIR=./data
# Required for Compose: set to the actual shared Traefik network subnet(s).
# Find with: docker network inspect traefik --format '{{json .IPAM.Config}}'
# Comma-separated IP addresses/CIDRs; never use true or trust every address.
TRUST_PROXY=
